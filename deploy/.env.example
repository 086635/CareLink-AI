# CareLink-AI 环境变量示例（复制为 .env 后按实际环境填写）
# 服务
PORT=3000
NODE_ENV=development

# 数据库（华为云 RDS for MySQL 8.0）
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=carelink
DATABASE_PASSWORD=change-me
DATABASE_NAME=carelink
DATABASE_SYNC=false

# 缓存（华为云 DCS Redis 5.x 主备）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# 认证
JWT_SECRET=change-me-to-random-32-chars
JWT_EXPIRES_IN=2h
DEVICE_KEY_SALT=change-me-to-random-16-chars

# LLM（OpenAI 兼容协议，可在 ModelArts 与任一兼容服务间切换）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me